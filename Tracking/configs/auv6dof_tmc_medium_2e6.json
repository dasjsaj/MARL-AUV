{
  "description": "IEEE TMC 2e6 main comparison, medium 4-AUV AUV6DOF target tracking. Only STG-MAPPO uses semantic state/task-graph/reward and velocity3; all other algorithms use raw non-semantic observations and tau6/codebook actions.",
  "env": "auv6dof",
  "scenario": "medium",
  "algos": ["stg_mappo", "maddpg", "matd3", "mappo", "happo", "atoc", "madqn", "masac"],
  "seeds": [0, 1, 2],
  "max_env_step": 2000000,
  "n_agent": 4,
  "episode_length": 500,
  "collector_env_num": 4,
  "evaluator_env_num": 2,
  "eval_interval_steps": 5000,
  "eval_horizon_steps": 500,
  "trained_eval_episodes": 30,
  "output_root": "artifacts/auv6dof_tmc_2e6/medium_4auv",
  "run_tag": "tmc_medium_2e6",
  "codebook_size": 125,
  "discrete_level": 5,
  "env_overrides": {
    "tail_eval_steps": 100,
    "boundary_guard_enabled": false,
    "separation_guard_enabled": false,
    "eval_log_format": "csv",
    "verbose_eval": false,
    "reset": {
      "curriculum_stage": "auto",
      "train_curriculum_stage": "auto",
      "eval_curriculum_stage": "medium",
      "min_init_separation": 0.10,
      "auto_easy_episodes": 800,
      "auto_medium_episodes": 2000
